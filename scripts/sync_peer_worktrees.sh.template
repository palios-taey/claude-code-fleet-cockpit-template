#!/usr/bin/env bash
# sync_peer_worktrees.sh — bring each peer worktree onto its parent repo's
# current HEAD so peers see CANONICAL state (not whatever stale branch
# they were initialized on).
#
# Strategy: for each peer worktree, look up the parent repo from a mapping,
# determine the parent's current branch, and reset the peer worktree to
# match. Preserves the worktree mechanism (write isolation via peer/<name>
# branch when commits happen) but eliminates read-side branch drift.
#
# Safe to run repeatedly. Logs to /tmp/sync-peer-worktrees.log.
#
# Per Jesse 2026-05-15: peers should have access to everything; the
# original worktree convention was over-isolating reads.

set -uo pipefail

LOG=/tmp/sync-peer-worktrees.log
exec >> "$LOG" 2>&1

echo "=== $(date -Iseconds) sync run ==="

# peer-worktree-name -> parent-repo-path
declare -A PARENT_OF=(
    [conductor-codex]=/home/mira/the-conductor
    [conductor-gemini]=/home/mira/the-conductor
    [weaver-codex]=/home/mira/embedding-server
    [weaver-gemini]=/home/mira/embedding-server
    [tutor-codex]=/home/mira/embedding-server
    [tutor-gemini]=/home/mira/embedding-server
    [infra-codex]=/home/mira/infra-soul
    [infra-gemini]=/home/mira/infra-soul
    [taeys-hands-codex]=/home/mira/taeys-hands
    [taeys-hands-gemini]=/home/mira/taeys-hands
    [treasurer-codex]=/home/mira/treasurer
    [treasurer-gemini]=/home/mira/treasurer
    [taey-ed-codex]=/home/mira/taey-ed
    [taey-ed-gemini]=/home/mira/taey-ed
    [x-claude-codex]=/home/mira/x-claude
    [x-claude-gemini]=/home/mira/x-claude
    [hunter-codex]=/home/mira/hunter
    [hunter-gemini]=/home/mira/hunter
    [conductor-grok]=/home/mira/the-conductor
    [weaver-grok]=/home/mira/embedding-server
    [tutor-grok]=/home/mira/embedding-server
    [infra-grok]=/home/mira/infra-soul
    [taeys-hands-grok]=/home/mira/taeys-hands
    [treasurer-grok]=/home/mira/treasurer
    [taey-ed-grok]=/home/mira/taey-ed
    [x-claude-grok]=/home/mira/x-claude
    [hunter-grok]=/home/mira/hunter
)

for peer in "${!PARENT_OF[@]}"; do
    parent="${PARENT_OF[$peer]}"
    worktree="/home/mira/.peer-worktrees/$peer"

    [ ! -d "$worktree" ] && { echo "  [$peer] worktree missing — skip"; continue; }
    [ ! -d "$parent" ]   && { echo "  [$peer] parent $parent missing — skip"; continue; }

    parent_branch=$(git -C "$parent" rev-parse --abbrev-ref HEAD 2>/dev/null)
    parent_head=$(git -C "$parent" rev-parse HEAD 2>/dev/null)
    worktree_head=$(git -C "$worktree" rev-parse HEAD 2>/dev/null)

    if [ "$parent_head" = "$worktree_head" ]; then
        echo "  [$peer] already at parent HEAD $parent_head — skip"
        continue
    fi

    # Hard reset peer branch to parent's HEAD. Any peer commits land in reflog
    # (not destroyed, recoverable via git reflog if needed). For the read-side
    # use case (GitNexus, surveys, audits), this is what we want.
    echo "  [$peer] sync $worktree_head → $parent_head ($parent_branch)"
    git -C "$worktree" reset --hard "$parent_head" 2>&1 | tail -2
done

echo

#!/usr/bin/env bash
# GitNexus keepalive — walk all known indexed paths, re-analyze on staleness.
#
# Triggered:
#   - cron every 10min (catches external commits, branch updates, fetches)
#   - peer-respawn.sh after each peer spawn (catches first-boot indexing)
#   - manually any time
#
# Indexing must stay current, fleet-wide.
#
# ── TEMPLATE SETUP ─────────────────────────────────────────────────────────
# Fill in your fleet layout below (or export these before invoking):
#   FLEET_REPOS         — space-separated absolute paths to your parent repos
#   PEER_WORKTREES_DIR  — directory holding your peer worktrees (one per peer)
# Both must be set; there are NO defaults (fail-loud, per cockpit discipline).
# ───────────────────────────────────────────────────────────────────────────

set -uo pipefail

LOG=/tmp/gitnexus-keepalive.log
exec >> "$LOG" 2>&1

echo "=== $(date -Iseconds) keepalive run ==="

# Canonical repos (parent sessions' working directories).
# EITHER export FLEET_REPOS before running, OR replace the placeholder list.
: "${FLEET_REPOS:=}"
if [ -z "$FLEET_REPOS" ]; then
    FLEET_REPOS="
        /path/to/your/repo-one
        /path/to/your/repo-two
    "
fi

# Where your peer worktrees live (one subdir per peer).
# Export PEER_WORKTREES_DIR before running, OR replace the placeholder.
: "${PEER_WORKTREES_DIR:=/path/to/your/.peer-worktrees}"

# shellcheck disable=SC2206
CANONICALS=( $FLEET_REPOS )

# All peer worktrees under $PEER_WORKTREES_DIR
PEERS=()
if [ -d "$PEER_WORKTREES_DIR" ]; then
    for d in "$PEER_WORKTREES_DIR"/*/; do
        [ -d "$d" ] && PEERS+=("${d%/}")
    done
fi

reanalyze_if_stale() {
    local path="$1"
    [ ! -d "$path/.git" ] && [ ! -e "$path/.git" ] && return
    cd "$path" || return
    local status_out
    status_out=$(gitnexus status 2>&1)
    if echo "$status_out" | grep -q "Repository not indexed"; then
        echo "  [$path] not indexed → analyze"
        gitnexus analyze 2>&1 | tail -3
    elif echo "$status_out" | grep -q "stale"; then
        echo "  [$path] stale → re-analyze"
        gitnexus analyze 2>&1 | tail -3
    else
        echo "  [$path] up-to-date"
    fi
}

for p in "${CANONICALS[@]}" "${PEERS[@]}"; do
    reanalyze_if_stale "$p"
done

echo
